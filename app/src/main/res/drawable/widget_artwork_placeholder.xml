<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the launcher preview and before the first update; the updater draws the same thing as a bitmap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_placeholder" />
            <corners android:radius="4dp" />
            <size
                android:width="96dp"
                android:height="96dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_widget_music_note"
        android:gravity="center"
        android:width="40dp"
        android:height="40dp" />
</layer-list>
